# OSRM Railway deployment – copy to Railway Variables or use with railway variable set
# Optional: override in Railway dashboard (Variables tab) or via CLI:
#   railway variable set OSRM_PROFILE=bicycle
#   railway variable set OSRM_OSM_URL=https://download.geofabrik.de/asia/india/southern-zone-latest.osm.pbf

# Data directory (mount a volume at /data for persistence)
OSRM_DATA_DIR=/data

# Lua profile: car, bicycle, foot (bicycle = bikes, cycleways, bike-friendly roads)
OSRM_PROFILE=bicycle

# Base name for the region file when auto-downloading
OSRM_REGION_NAME=region

# Geofabrik OSM extract URL (used when /data is empty)
# India Southern Zone (Bangalore/Karnataka, Tamil Nadu, Kerala, etc.)
OSRM_OSM_URL=https://download.geofabrik.de/asia/india/southern-zone-latest.osm.pbf

# Railway sets PORT automatically; the startup script uses it for osrm-routed.
